{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "sound-of-loam",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sound-of-loam",
			"database_id": "0d99cea2-41e0-412d-96c5-8a3826717cca"
		}
	]
}
